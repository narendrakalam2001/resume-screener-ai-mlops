# ============================================================
# DOCKERFILE.DASHBOARD — Resume Screener AI
# ============================================================
# Streamlit monitoring dashboard container
# ============================================================

FROM python:3.10.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_dashboard.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements_dashboard.txt

# Copy all project files (dashboard reads from resume_models/ and logs/)
COPY src/           ./src/
COPY monitoring/    ./monitoring/
COPY resume_models/ ./resume_models/
COPY logs/          ./logs/

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8501/_stcore/health', timeout=5)" || exit 1

CMD ["streamlit", "run", "monitoring/monitoring_dashboard.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
